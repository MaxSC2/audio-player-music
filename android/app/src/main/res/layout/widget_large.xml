<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="NeonWave"/>

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:text="Откройте плеер"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/w_shuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_shuffle_off"/>

            <ImageView
                android:id="@+id/w_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_prev"/>

            <ImageView
                android:id="@+id/w_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_play_bg"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_play"/>

            <ImageView
                android:id="@+id/w_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_next"/>

            <ImageView
                android:id="@+id/w_repeat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_bg"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_repeat_off"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
